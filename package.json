{
  "name": "petshop-management-system",
  "version": "1.0.2",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "cundus",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "drizzle:generate": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config=drizzle.pg.config.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/x-data-grid": "^8.22.0",
    "@mui/x-date-pickers": "^8.19.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.7",
    "electron-printer": "^0.0.5",
    "electron-updater": "^6.3.9",
    "node-thermal-printer": "^4.5.0",
    "pg": "^8.16.3",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.6",
    "silly": "^0.2.0",
    "sql.js": "^1.13.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.7",
    "electron": "^39.2.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  }
}
