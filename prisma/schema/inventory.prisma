////////////////////////////////////////////////////
// INVENTORY MANAGEMENT
// ProductLocation, StockTransaction, StockAdjustment
////////////////////////////////////////////////////

////////////////////////////////////////////////////
// PRODUCT LOCATION (Store Inventory)
////////////////////////////////////////////////////

model ProductLocation {
  id               String  @id @default(uuid()) @map("id")
  productId        String  @map("product_id")
  storeId          String  @map("store_id")
  location         String? @map("location")
  quantity         Int     @default(0) @map("quantity")
  reservedQuantity Int     @default(0) @map("reserved_quantity")

  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")
  deviceId  String?   @map("device_id")

  // Relations
  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@map("product_location")
}

////////////////////////////////////////////////////
// STOCK TRANSACTION LEDGER
////////////////////////////////////////////////////

enum StockTransactionType {
  INBOUND
  OUTBOUND
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  SALE
}

model StockTransaction {
  id          String               @id @default(uuid()) @map("id")
  productId   String               @map("product_id")
  storeId     String               @map("store_id")
  type        StockTransactionType @map("type")
  quantity    Int                  @map("quantity")
  reference   String?              @map("reference")
  batchId     String?              @map("batch_id")
  supplierId  String?              @map("supplier_id")
  customerId  String?              @map("customer_id")
  performedBy String               @map("performed_by")

  createdAt DateTime  @default(now()) @map("created_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")
  deviceId  String?   @map("device_id")

  // Relations
  product  Product   @relation(fields: [productId], references: [id])
  store    Store     @relation(fields: [storeId], references: [id])
  batch    Batch?    @relation(fields: [batchId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  user     User      @relation(fields: [performedBy], references: [id])

  @@map("stock_transaction")
}

////////////////////////////////////////////////////
// STOCK ADJUSTMENT
////////////////////////////////////////////////////

model StockAdjustment {
  id          String  @id @default(uuid()) @map("id")
  productId   String  @map("product_id")
  storeId     String  @map("store_id")
  difference  Int     @map("difference")
  note        String? @map("note")
  performedBy String  @map("performed_by")

  createdAt DateTime  @default(now()) @map("created_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")
  deviceId  String?   @map("device_id")

  // Relations
  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
  user    User    @relation(fields: [performedBy], references: [id])

  @@map("stock_adjustment")
}
